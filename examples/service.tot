name "example-service"
image "registry.example/example-service:v1.4.2"
replicas 5
debug false
listen {
  host "0.0.0.0"
  port 8080
}
retries 3
timeout 30
regions [
  "us-west-2"
  "eu-central-1"
]
endpoints [
  "https://us-west-2.example.net"
  "https://eu-central-1.example.net"
]
zones [
  {
    region "us-west-2"
    primary false
  }
  {
    region "eu-central-1"
    primary false
  }
]
