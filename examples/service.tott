# A tot template. Everything here is ordinary tot except the `(head arg…)` forms, which are
# evaluated at build time and replaced by their value:
#
#   tot build --set=prod=true --set-raw=tag=v1.4.2 --out=examples/service.tot examples/service.tott
#
# `tot build --check` verifies that examples/service.tot is still what this builds.

name "example-service"

# A parameter with no default is required, so a build that forgets one fails instead of
# guessing. `--set-raw=tag=v1.4.2` sets it; `--set=tag=…` would want the quotes.
image (str "registry.example/example-service:" (param "tag"))

# `if` takes a boolean. tot has no truthiness in a template any more than in a document, so
# the condition has to be one — here a parameter that defaults to false.
replicas (if (param "prod" false) 5 1)
debug (if (param "prod" false) false true)

listen {
  # `get` reads out of a value you hand it, and never out of the document being built — that
  # would make this file mean something different depending on the order its members happened
  # to be evaluated in.
  host (get "listen.host" (import "defaults.tot"))
  port (param "port" 8080)
}

retries (get "limits.retries" (import "defaults.tot"))

# A third argument is what to use when the path is not there, which is the only way to reach a
# member that may be missing: `if` wants a boolean, and there is no `has`.
timeout (get "limits.timeout" (import "defaults.tot") 30)

# `import` embeds one value, resolved relative to this file so the pair can be moved together.
# Splicing one document's members into another is `tot merge`, which is a different operation.
regions (import "regions.tot")

# `map` evaluates its body once per element, with `(it)` standing for the element. It is the
# one form that needs a placeholder, and the placeholder is a form because everything computed
# in tot sits inside parens — `_` would have been shorter and would have broken that.
endpoints (map (str "https://" (it) ".example.net") (import "regions.tot"))

# A body is a value like any other, so it can be a collection — which is how a list of names
# becomes a list of objects.
zones (map
  {
    region (it)
    primary false
  }
  (import "regions.tot")
)
