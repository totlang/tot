# Astro
dist/
.astro/
node_modules/

# Generated by `npm run wasm` from ./wasm. Building it is part of `npm run build`, so a fresh
# checkout needs the Rust toolchain and wasm-pack rather than a committed binary.
src/wasm/

# The wasm crate is outside the cargo workspace, so it keeps its own build directory.
wasm/target/
