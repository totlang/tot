# Astro
dist/
.astro/
node_modules/

# pnpm is the package manager here (package.json names it). An `npm install` run by habit would
# write this and then drift from pnpm-lock.yaml, with two lockfiles disagreeing about the tree.
package-lock.json

# Generated by `pnpm run wasm` from ./wasm. Building it is part of `pnpm build`, so a fresh
# checkout needs the Rust toolchain and wasm-pack rather than a committed binary.
src/wasm/

# The wasm crate is outside the cargo workspace, so it keeps its own build directory.
wasm/target/
