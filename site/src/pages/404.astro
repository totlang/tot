---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import TotMark from '../components/TotMark.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Not found — tot" description="There is nothing at this path." noindex>
  <Nav />

  <main class="lost">
    <TotMark size={104} burnt />

    <div class="head">
      <p class="code">404</p>
      <h1>Nothing at this path.</h1>
    </div>

    {/* What `tot get` actually prints for a path the document does not have. */}
    <pre class="sample"><span class="tp">$</span> <span class="tk">tot get</span> <span class="tk"
        >burnt.tot</span
      > <span class="tk">site.tot</span>
<span class="tc">tot: in site.tot: no member `burnt` in the document</span></pre>

    <div class="actions">
      <a class="btn btn-primary" href="/docs">Back to the docs</a>
      <a href="/">Home</a>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.625rem;
    padding: clamp(3rem, 10vh, 6rem) var(--gutter);
    text-align: center;
  }

  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .code {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--muted);
    margin: 0;
  }

  h1 {
    font-size: clamp(1.875rem, 5vw, 2.375rem);
  }

  .sample {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.8;
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    text-align: left;
    max-width: 100%;
    overflow-x: auto;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
